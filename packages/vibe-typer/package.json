{
  "name": "@mcp-arcade-cabinets/vibe-typer",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "@mcp-arcade-cabinets/tape-core": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. exec vitest run packages/vibe-typer/test",
    "build": "esbuild src/play.ts --bundle --platform=node --format=esm --outfile=dist/play.js --log-level=warning",
    "port:corpus": "node scripts/port-corpus.mjs",
    "author": "node scripts/author.mjs",
    "sweep:levels": "node scripts/sweep-levels.mjs"
  }
}
