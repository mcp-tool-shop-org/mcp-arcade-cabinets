{
  "name": "@mcptoolshop/ghost-on-the-menu",
  "version": "0.8.2",
  "description": "An arcade shooter where you are the agent, played against what MCP servers actually said on the wire. Plays in your browser or runs as an MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ghost-on-the-menu": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "game",
    "arcade",
    "shooter",
    "agent",
    "ollama",
    "shmup"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. exec vitest run packages/launcher/test",
    "pack:dist": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-tool-shop-org/mcp-arcade-cabinets.git",
    "directory": "packages/launcher"
  },
  "bugs": {
    "url": "https://github.com/mcp-tool-shop-org/mcp-arcade-cabinets/issues"
  },
  "homepage": "https://mcp-tool-shop-org.github.io/mcp-arcade-cabinets/"
}
