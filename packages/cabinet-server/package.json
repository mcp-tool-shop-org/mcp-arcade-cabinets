{
  "name": "@mcp-arcade-cabinets/cabinet-server",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "cabinet-server": "dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@mcp-arcade-cabinets/ghost-on-the-menu": "workspace:*",
    "@mcp-arcade-cabinets/tape-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. exec vitest run packages/cabinet-server/test",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --log-level=warning --banner:js=\"#!/usr/bin/env node\" && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --log-level=warning"
  }
}
