{
  "name": "@mcptoolshop/vibe-typer",
  "version": "0.12.0",
  "description": "A typing arcade game where you are a coding agent. Your user has an idea, you type the code, and the thing gets built while you both watch.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vibe-typer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "typing",
    "typing-game",
    "game",
    "arcade",
    "agent",
    "coding",
    "ollama",
    "mcp",
    "model-context-protocol"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. exec vitest run packages/launcher-vibe-typer/test",
    "pack:dist": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-tool-shop-org/mcp-arcade-cabinets.git",
    "directory": "packages/launcher-vibe-typer"
  },
  "bugs": {
    "url": "https://github.com/mcp-tool-shop-org/mcp-arcade-cabinets/issues"
  },
  "homepage": "https://mcp-tool-shop-org.github.io/mcp-arcade-cabinets/"
}
